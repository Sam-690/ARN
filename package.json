{
  "name": "obra-control",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm run dev -w @obra/api\" \"npm run dev -w @obra/web\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:start": "bash scripts/db-local.sh start",
    "db:stop": "bash scripts/db-local.sh stop",
    "setup": "npm run db:start && npm run db:generate && npm run db:migrate && npm run db:seed",
    "build": "npm run build -w @obra/api && npm run build -w @obra/web",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "bash scripts/test-integration.sh",
    "format": "prettier --write . && prisma format",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "^16.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
